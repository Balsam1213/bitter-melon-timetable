<?xml version="1.0" encoding="utf-8"?>
<!-- API ≥ 32 的备份/换机迁移范围：课程数据库 + DataStore 设置（含节假日/调休数据） -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
